# GEMINI_API_KEY: Optional Gemini AI API key for platform compatibility
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# BSCSCAN_API_KEY: Optional/Recommended API key for BscScan / Etherscan V2 queries (get free from https://bscscan.com/myapikey)
BSCSCAN_API_KEY=""

# TRONGRID_API_KEY: Optional API key for high-throughput TronGrid queries (https://www.trongrid.io)
TRONGRID_API_KEY=""

