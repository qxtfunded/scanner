# ==========================================
# Frontend Client-Side Keys (for Vercel / Static Deployment)
# Set these in your Vercel Project Settings -> Environment Variables
# ==========================================

# Optional/Recommended API key for BscScan / Etherscan V2 (free at https://bscscan.com/myapikey)
VITE_BSCSCAN_API_KEY=""

# Optional API key for high-throughput TronGrid queries (https://www.trongrid.io)
VITE_TRONGRID_API_KEY=""

# ==========================================
# Server-Side Keys (Optional for Node.js / Container Deployment)
# ==========================================
BSCSCAN_API_KEY=""
TRONGRID_API_KEY=""

# Platform injection (optional)
GEMINI_API_KEY=""
APP_URL=""
